# Strategic AI Advisor - Backend environment
# Copy this file to .env.backend and fill in your values:
#   copy .env.backend.example .env.backend
#
# Minimum to run: Twilio (for WhatsApp/voice). Add others as you need them.

# ============================================
# Twilio (required for WhatsApp / SMS / voice)
# Get from https://console.twilio.com
# ============================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
# WhatsApp sender (e.g. Twilio sandbox: whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ============================================
# CEO / primary contact (optional; can set in Config Dashboard)
# ============================================
# CEO_PHONE_NUMBER=+1234567890
# CEO_WHATSAPP_NUMBER=+1234567890
# CEO_EMAIL=ceo@company.com

# ============================================
# Claude AI - for chat and briefings
# Get from https://console.anthropic.com
# ============================================
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Voice transcription (optional - for WhatsApp voice notes)
# Use one: Groq (free) https://console.groq.com  OR  OpenAI https://platform.openai.com
# ============================================
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Email (optional - for alerts/briefings)
# SendGrid OR Gmail/Outlook - uncomment and fill one set
# ============================================
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM=noreply@yourdomain.com

# Or Gmail / Outlook:
# EMAIL_PROVIDER=gmail
# EMAIL_USER=your@gmail.com
# EMAIL_PASSWORD=your_app_password
# Or: OUTLOOK_EMAIL=you@company.com  and  OUTLOOK_PASSWORD=your_password

# ============================================
# Gmail "Sign in with Google" (optional)
# For Additional mailboxes: no App Password needed.
# Create OAuth client: https://console.cloud.google.com/apis/credentials
# Add redirect URI: http://localhost:5173/api/auth/google/callback (when UI on 5173)
# Or if you use BACKEND_URL: http://localhost:3000/api/auth/google/callback
# ============================================
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# ============================================
# StarkNavigator – real stock data (optional)
# Get free key: https://www.alphavantage.co/support/#api-key
# Without this, stock recommendations use mock data.
# ============================================
# ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here

# ============================================
# Backend (optional)
# ============================================
# BACKEND_PORT=3000
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:3000
